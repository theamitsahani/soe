rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if caller is an active Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE')
      );
    }

    // Helper function to check if caller is an active Employee
    function isEmployee() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE'
      );
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read user profiles (for employee assignments, directory, auth checks)
      allow read: if isAuthenticated();
      // Admin can create, update, disable, delete any user document
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
    
    // Schools Master Data Collection
    match /schools/{schoolId} {
      // Authenticated users (Admin and Field Employees) can read schools
      allow read: if isAuthenticated();
      // Admin can add, update, delete, bulk import schools; Employees can update school info from visit
      allow write: if isAdmin() || isEmployee();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      // Admin can read all tasks; Employee can read tasks assigned to them
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      // Admin can create, edit, assign, delete tasks; Employee can update status of their task
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
    }

    // Visits Collection
    match /visits/{visitId} {
      // Admin can read all visits; Employee can read visits submitted by them
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      // Employee can submit their visit; Admin can update/review/delete visits
      allow create: if isAdmin() || (isEmployee() && request.resource.data.employeeId == request.auth.uid);
      allow update: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
