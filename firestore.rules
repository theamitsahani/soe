rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // =========================================================================

    // Check if the caller is currently authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the caller has an active Admin or Super Admin role
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'] ||
        request.auth.token.admin == true ||
        request.auth.token.email in ['amitsahani552@gmail.com', 'admin@gmail.com', 'admin@soe.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN', 'admin', 'super_admin'] &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
         !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == true))
      );
    }

    // Check if the caller is a Reviewer or Supervisor
    function isReviewer() {
      return isAdmin() || (isAuthenticated() && (
        request.auth.token.role in ['REVIEWER', 'SUPERVISOR'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['REVIEWER', 'SUPERVISOR'] &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
         !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == true))
      ));
    }

    // Check if the caller is an active registered user/employee
    function isEmployee() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == true)
      );
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    // Admin has full control. Users can only read/update their own profile safely.
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        resource != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'mobile', 'mustChangePassword', 'updatedAt', 'profilePhotoUrl', 'fcmToken'])
      );
    }

    // =========================================================================
    // SCHOOLS MASTER DATA COLLECTION
    // =========================================================================
    // All authenticated users can read school master list.
    // Admin has full write access.
    // Employees can update contact details, map links, and completion status upon visit.
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isEmployee() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'principalName', 'principalMobile', 'mapLink', 'latitude', 'longitude',
            'visitDate', 'status', 'isCompleted', 'completedAt', 'updatedAt'
          ])
      );
    }

    // =========================================================================
    // TASKS / ASSIGNMENTS COLLECTION
    // =========================================================================
    // Admin has full read/write.
    // Employees can read their assigned tasks and update status/visitId upon completion.
    match /tasks/{taskId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.employeeId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.employeeEmail == request.auth.token.email)
        )
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (
          resource.data.employeeId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.employeeEmail == request.auth.token.email)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'visitId', 'employeeId', 'employeeEmail', 'updatedAt']) &&
        request.resource.data.status in ['ASSIGNED', 'STARTED', 'IN_PROGRESS', 'SUBMITTED', 'REVIEWED', 'REJECTED', 'CANCELLED']
      );
    }

    // =========================================================================
    // VISITS / INSPECTIONS COLLECTION
    // =========================================================================
    // Full audit trail, immutable reviewed records, tamper prevention.
    match /visits/{visitId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.employeeId == request.auth.uid
      );
      
      // Employees can create their own visit reports
      allow create: if isAdmin() || (
        isEmployee() && request.resource.data.employeeId == request.auth.uid
      );
      
      // Employees can update draft or submitted visits (unless locked as REVIEWED by admin)
      allow update: if isAdmin() || (
        isEmployee() &&
        resource.data.employeeId == request.auth.uid &&
        resource.data.status != 'REVIEWED' &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.schoolId == resource.data.schoolId
      );
      
      allow delete: if isAdmin();

      // Photos metadata subcollection
      match /photos/{photoId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid
        );
        allow create, update, delete: if isAdmin() || (
          isEmployee() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.status != 'REVIEWED'
        );
      }

      // Audit Events subcollection (Supports both /events and /visitEvents paths)
      match /events/{eventId} {
        allow read: if isAdmin() || isReviewer() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid
        );
        allow create: if isAdmin() || isReviewer() || (
          isEmployee() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid
        );
        allow update, delete: if false; // Append-only audit trail
      }

      match /visitEvents/{eventId} {
        allow read: if isAdmin() || isReviewer() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid
        );
        allow create: if isAdmin() || isReviewer() || (
          isEmployee() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid
        );
        allow update, delete: if false; // Append-only audit trail
      }
    }

    // =========================================================================
    // IMPORT BATCHES COLLECTION
    // =========================================================================
    match /importBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        (
          resource.data.recipientUserId == request.auth.uid ||
          resource.data.recipientUserId == 'ADMIN' ||
          resource.data.recipientUserId == 'ALL'
        )
      );
      
      // Admins and Employees can create notifications for each other
      allow create: if isAdmin() || isEmployee();
      
      // Recipients or Admin can update read status or delete notifications
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (
          resource.data.recipientUserId == request.auth.uid ||
          resource.data.recipientUserId == 'ADMIN' ||
          resource.data.recipientUserId == 'ALL'
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        (
          resource.data.recipientUserId == request.auth.uid ||
          resource.data.recipientUserId == 'ADMIN' ||
          resource.data.recipientUserId == 'ALL'
        )
      );
    }

    // =========================================================================
    // DEFAULT CATCH-ALL RULE
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
