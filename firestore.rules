rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if caller is an active Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
         !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == true))
      );
    }

    // Helper function to check if caller is an active Employee
    function isEmployee() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE' &&
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDeleted == true)
      );
    }

    // Users Collection: Privilege escalation prevention
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // Admin has full create and delete control
      allow create, delete: if isAdmin();
      // Non-admin users can ONLY update their own safe profile fields (name, mobile, mustChangePassword, updatedAt).
      // They CANNOT self-escalate role, change status, or resurrect deleted accounts.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        resource != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'mobile', 'mustChangePassword', 'updatedAt'])
      );
    }
    
    // Schools Master Data Collection
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      // Admin has full control for creating, deleting, and updating school master data
      allow create, delete: if isAdmin();
      // Employees can only correct contact info (principalName, principalMobile, updatedAt) during visits
      allow update: if isAdmin() || (
        isEmployee() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['principalName', 'principalMobile', 'updatedAt']) &&
        (!('principalMobile' in request.resource.data) || request.resource.data.principalMobile.size() <= 15)
      );
    }

    // Tasks Collection: Mass-assignment prevention
    match /tasks/{taskId} {
      // Admin can read all tasks; Employee can only read tasks assigned to them
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, delete: if isAdmin();
      // Employee cannot reassign task ownership or change schoolId; can only update workflow status and updatedAt
      allow update: if isAdmin() || (
        isEmployee() &&
        resource.data.employeeId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['ASSIGNED', 'SUBMITTED', 'REVIEWED']
      );
    }

    // Visits Collection: Visit tampering prevention & REVIEWED lock
    match /visits/{visitId} {
      // Admin can read all visits; Employee can only read visits submitted by them
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      // Employee can submit their own visit (employeeId must match auth.uid)
      allow create: if isAdmin() || (isEmployee() && request.resource.data.employeeId == request.auth.uid);
      // Employee cannot change visit ownership/school and cannot modify a visit once it is marked REVIEWED
      allow update: if isAdmin() || (
        isEmployee() &&
        resource.data.employeeId == request.auth.uid &&
        resource.data.status != 'REVIEWED' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'answersJson', 'photosJson', 'syncStatus', 'updatedAt']) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.schoolId == resource.data.schoolId &&
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status == 'SUBMITTED')
      );
      allow delete: if isAdmin();

      // Photos metadata subcollection: Cross-employee deletion/tampering prevention
      match /photos/{photoId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin() || (
          isEmployee() &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.employeeId == request.auth.uid &&
          get(/databases/$(database)/documents/visits/$(visitId)).data.status != 'REVIEWED'
        );
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
